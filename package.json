{
  "name": "localleaf",
  "displayName": "LocalLeaf",
  "description": "Local LaTeX Editing yet Synced to Overleaf",
  "version": "0.1.3",
  "publisher": "teddy-van-jerry",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teddy-van-Jerry/LocalLeaf"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "overleaf",
    "sync",
    "tex"
  ],
  "activationEvents": [
    "workspaceContains:.localleaf",
    "onView:localleaf.projectsView",
    "onView:localleaf.mainView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localleaf",
          "title": "LocalLeaf",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "localleaf": [
        {
          "id": "localleaf.projectsView",
          "name": "Projects",
          "type": "webview",
          "when": "!localleaf.isLinked"
        },
        {
          "id": "localleaf.mainView",
          "name": "LocalLeaf",
          "type": "webview",
          "when": "localleaf.isLinked"
        }
      ]
    },
    "commands": [
      {
        "command": "localleaf.login",
        "title": "LocalLeaf: Login"
      },
      {
        "command": "localleaf.logout",
        "title": "LocalLeaf: Logout"
      },
      {
        "command": "localleaf.showAccountPanel",
        "title": "LocalLeaf: Account"
      },
      {
        "command": "localleaf.linkFolder",
        "title": "LocalLeaf: Link Folder to Overleaf Project"
      },
      {
        "command": "localleaf.unlinkFolder",
        "title": "LocalLeaf: Unlink Folder"
      },
      {
        "command": "localleaf.syncNow",
        "title": "LocalLeaf: Sync Now"
      },
      {
        "command": "localleaf.pullFromOverleaf",
        "title": "LocalLeaf: Pull from Overleaf"
      },
      {
        "command": "localleaf.pushToOverleaf",
        "title": "LocalLeaf: Push to Overleaf"
      },
      {
        "command": "localleaf.editIgnorePatterns",
        "title": "LocalLeaf: Edit Ignore Patterns"
      },
      {
        "command": "localleaf.cleanIgnoredRemoteFiles",
        "title": "LocalLeaf: Clean Ignored Files from Overleaf"
      },
      {
        "command": "localleaf.showSyncStatus",
        "title": "LocalLeaf: Show Sync Status"
      },
      {
        "command": "localleaf.setMainDocument",
        "title": "LocalLeaf: Set Main Document"
      },
      {
        "command": "localleaf.configure",
        "title": "LocalLeaf: Configure Settings"
      },
      {
        "command": "localleaf.jumpToCollaborator",
        "title": "LocalLeaf: Jump to Collaborator"
      },
      {
        "command": "localleaf.verifyCredentials",
        "title": "LocalLeaf: Verify Credentials"
      },
      {
        "command": "localleaf.refreshCookie",
        "title": "LocalLeaf: Refresh Cookie"
      }
    ],
    "configuration": {
      "title": "LocalLeaf",
      "properties": {
        "localleaf.defaultServer": {
          "type": "string",
          "default": "https://www.overleaf.com",
          "description": "Default Overleaf server URL"
        },
        "localleaf.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic sync when files change"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "postinstall": "patch-package",
    "website:dev": "npm run dev --prefix docs/website",
    "website:build": "npm run build --prefix docs/website"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "@types/socket.io-client": "^1.4.36",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "patch-package": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.9",
    "node-fetch": "^2.7.0",
    "socket.io-client": "https://codeload.github.com/overleaf/socket.io-client/tar.gz/805a73d2a2e2408982597d5986a401088b7aa588"
  },
  "overrides": {
    "ajv": "6.15.0",
    "brace-expansion@1.1.12": "1.1.18",
    "brace-expansion@2.0.2": "2.1.4",
    "flatted": "3.4.4",
    "js-yaml": "4.3.1",
    "minimatch@3.1.2": "3.1.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "picomatch": "2.3.2",
    "tmp": "0.2.7",
    "yaml": "2.9.0",
    "ws": "5.2.7"
  }
}
